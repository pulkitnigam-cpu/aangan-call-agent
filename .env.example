# Copy to .env.local and fill in. Never commit real values.

# --- Database: Neon (plain Postgres) -----------------------------------------
# Pooled connection string, used by the app on Vercel.
#   Neon:     Dashboard > Connect > "Pooled connection" (host contains -pooler)
#   Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=
# Optional direct connection for running migrations.
#   Neon: the non-pooled string   Supabase: "Direct connection" or "Session pooler" (port 5432)
DATABASE_URL_UNPOOLED=
# Optional: connections per serverless instance (default 5)
DB_POOL_MAX=

# --- Vaani Voice (voice agent) — https://app.vaanivoice.ai/developers/api-key ---
VANI_API_KEY=
# Set after `npm run vaani:setup -- --apply` creates the agent
VANI_AGENT_ID=
# Gemini model inside Vaani (pick from the dashboard's LLM list)
VANI_LLM_MODEL=gemini-3.5-flash
# Number callers reach (E.164), assigned as the agent's inbound number
VANI_INBOUND_NUMBER=
# Random 32+ chars. Goes in the webhook URL: /api/voice/webhook?token=...
VANI_WEBHOOK_TOKEN=
# Random 32+ chars. Sent by the agent's tools in the X-Aangan-Tool-Key header
VANI_TOOL_SECRET=
# Only if Vaani signs webhooks for your account (X-Vaani-Signature)
VANI_WEBHOOK_SECRET=

# --- Gemini (LLM) ------------------------------------------------------------
GEMINI_API_KEY=
# Check Google AI Studio for the current model name
GEMINI_MODEL=gemini-3.8-flash

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Any random string; also passed as secret_token when registering the webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FRONTDESK_CHAT_ID=
TELEGRAM_NIKHIL_CHAT_ID=

# --- Calendly ----------------------------------------------------------------
# Optional: only to register the Calendly webhook via API (you can do it in Calendly instead)
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- HubSpot -----------------------------------------------------------------
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=
# Stage ids: run `npm run hubspot:setup` to print them
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_VISIT_BOOKED=
HUBSPOT_STAGE_VISIT_DONE=
HUBSPOT_STAGE_WON=
HUBSPOT_STAGE_LOST=

# --- Sweep + cost ------------------------------------------------------------
# Also add CRON_SECRET and SWEEP_URL as GitHub Actions secrets (.github/workflows/sweep.yml)
CRON_SECRET=
COST_PER_MIN_VANI_INR=
COST_PER_1K_INPUT_GEMINI_INR=
COST_PER_1K_OUTPUT_GEMINI_INR=

# --- App ----------------------------------------------------------------------
# The deployed https address (Telegram "Open in dashboard" links, webhooks)
APP_BASE_URL=http://localhost:3000
